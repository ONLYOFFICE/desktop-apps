#CX11Caption {min-width: 875px;}
#labelAppTitle {margin-top: -10px; font-size: 55px;}

QPushButton {border-width: 5px; padding: 0 100px; height: 110px; border-radius: 10px; font-size: 55px;}
QPushButton#toolButtonMaximize,
QPushButton#toolButtonMinimize,
QPushButton#toolButtonClose {padding: 25px 0px 35px;}

QPushButton#toolButtonMaximize[extended-title=true],
QPushButton#toolButtonMinimize[extended-title=true],
QPushButton#toolButtonClose[extended-title=true] {padding: 47px 0px 48px;}

QPushButton#toolButtonMaximize[kde=true],
QPushButton#toolButtonMinimize[kde=true],
QPushButton#toolButtonClose[kde=true] {padding: 10px 0px 35px;}

QPushButton#toolButtonMaximize[kde=true][extended-title=true],
QPushButton#toolButtonMinimize[kde=true][extended-title=true],
QPushButton#toolButtonClose[kde=true][extended-title=true] {padding: 0px 25px 30px 0px;}

#mainPanel[rtl=true] QPushButton#toolButtonMaximize[kde=true][extended-title=true],
#mainPanel[rtl=true] QPushButton#toolButtonMinimize[kde=true][extended-title=true],
#mainPanel[rtl=true] QPushButton#toolButtonClose[kde=true][extended-title=true] {padding: 0px 0px 30px 25px;}

QPushButton#toolButtonMain {font-size: 50px; border-width: 5px; border-radius: 30px; qproperty-icon: url(:/logo_light.svg);}
QPushButton#toolButtonMain[theme=light] {border-width: 5px; border-bottom: 0 none;}
QPushButton#toolButtonMain[class=normal],
QPushButton#toolButtonMain[class=normal]:hover {border-bottom-width: 5px;}
/*#mainPanel[rtl=true] QPushButton#toolButtonMain {border-width: 5px;}*/

QPushButton#toolButtonDownload {border-radius: 30px; max-width: 140px; width: 140px; max-height: 140px; height: 140px;}
#mainPanel[uithemetype=dark] QPushButton#toolButtonMain {qproperty-icon: url(:/logo_dark.svg);}

/* Menu */

#CMenuWidget #menuItem {
    min-height: 130px;
    padding-left: 125px; padding-right: 85px;
    font-size: 55px;
}
#CMenuWidget #menuFrame {border-width: 5px; border-radius: 20px;}
#CMenuWidget QFrame[frameShape="4"] {max-height: 5px;}
#mainPanel[uithemetype=dark] #CMenuWidget #menuItem {font-weight: normal;}

/* ToolTip*/

#CToolTip>QLabel {
    min-height: 130px;
    margin: 0px;
    padding-left: 50px; padding-right: 50px;
    font-size: 55px;
    border-width: 5px; border-radius: 23px;
}
#CToolTip[uitheme=theme-dark]>QLabel {border-width: 5px;}
#CToolTip[uitheme=theme-contrast-dark]>QLabel {border-width: 5px;}
