/*
@download-widget-background: %1;
@download-widget-border: %2;

@text-normal: %3;
@tool-button-hover-background: %4;
@tool-button-pressed-background: %5;

@border-control-focus: %6;
@text-pretty: %7;

@download-progressbar-chunk: %8;
@download-progressbar-background: %9;
*/

#centralwidget {background: %1;}
#centralwidget[rtl-font=true] QAbstractButton,
#centralwidget[rtl-font=true] QLabel {font-family: "Segoe UI", "Traditional Arabic", "Noto Sans";}

QAbstractButton,
QLabel {font-family: "Arial", "Helvetica", "Helvetica Neue", sans-serif;}

QProgressBar {border-radius: 2px; background-color: %9; border-color: %9; margin: 0px;}
QProgressBar::chunk {border-radius: 2px; background-color: %8;}
QLabel {color: %3; background: transparent;}

QAbstractButton {font-weight: normal;}
QPushButton::menu-indicator {width: 0px; height: 0px;}
#labelTitle {font-weight: bold;}

#btnDeclineInstall,
#btnRestartLater {color: %3; background: transparent;}

#btnDeclineInstall:hover,
#btnRestartLater:hover {background: %4;}

#btnDeclineInstall:pressed,
#btnRestartLater:pressed {background: %5;}

#btnAcceptInstall,
#btnRestartNow {color: %7; background: #4473ca;}

#btnAcceptInstall:hover,
#btnRestartNow:hover {background: %4;}

#btnAcceptInstall:pressed,
#btnRestartNow:pressed {background: %5;}

/* 1.0x */
QAbstractButton {border: 1px solid %2; border-radius: 3px; height: 14px; font-size: 11px; icon-size: 12px;}
QAbstractButton:focus {border-color: %6; border-width: 2px;}
QLabel {font-size: 11px;}

/* 1.25x */
#centralwidget[zoom="1.25x"] QAbstractButton {border-width: 1px; border-radius: 4px; height: 18px; font-size: 14px; icon-size: 15px;}
#centralwidget[zoom="1.25x"] QAbstractButton:focus {border-width: 3px;}
#centralwidget[zoom="1.25x"] QLabel {font-size: 14px;}

/* 1.5x */
#centralwidget[zoom="1.5x"] QAbstractButton {border-width: 2px; border-radius: 5px; height: 21px; font-size: 17px; icon-size: 18px;}
#centralwidget[zoom="1.5x"] QAbstractButton:focus {border-width: 3px;}
#centralwidget[zoom="1.5x"] QLabel {font-size: 17px;}

/* 1.75x */
#centralwidget[zoom="1.75x"] QAbstractButton {border-width: 2px; border-radius: 5px; height: 25px; font-size: 19px; icon-size: 21px;}
#centralwidget[zoom="1.75x"] QAbstractButton:focus {border-width: 4px;}
#centralwidget[zoom="1.75x"] QLabel {font-size: 19px;}

/* 2.0x */
#centralwidget[zoom="2x"] QAbstractButton {border-width: 2px; border-radius: 8px; height: 28px; font-size: 22px; icon-size: 24px;}
#centralwidget[zoom="2x"] QAbstractButton:focus {border-width: 4px;}
#centralwidget[zoom="2x"] QLabel {font-size: 22px;}

/* 2.25x */
#centralwidget[zoom="2.25x"] QAbstractButton {border-width: 2px; border-radius: 7px; height: 32px; font-size: 25px; icon-size: 27px;}
#centralwidget[zoom="2.25x"] QAbstractButton:focus {border-width: 5px;}
#centralwidget[zoom="2.25x"] QLabel {font-size: 25px;}

/* 2.5x */
#centralwidget[zoom="2.5x"] QAbstractButton {border-width: 3px; border-radius: 8px; height: 35px; font-size: 28px; icon-size: 30px;}
#centralwidget[zoom="2.5x"] QAbstractButton:focus {border-width: 5px;}
#centralwidget[zoom="2.5x"] QLabel {font-size: 28px;}

/* 2.75x */
#centralwidget[zoom="2.75x"] QAbstractButton {border-width: 3px; border-radius: 8px; height: 39px; font-size: 30px; icon-size: 33px;}
#centralwidget[zoom="2.75x"] QAbstractButton:focus {border-width: 6px;}
#centralwidget[zoom="2.75x"] QLabel {font-size: 30px;}

/* 3.0x */
#centralwidget[zoom="3x"] QAbstractButton {border-width: 3px; border-radius: 9px; height: 42px; font-size: 33px; icon-size: 36px;}
#centralwidget[zoom="3x"] QAbstractButton:focus {border-width: 6px;}
#centralwidget[zoom="3x"] QLabel {font-size: 33px;}

/* 3.5x */
#centralwidget[zoom="3.5x"] QAbstractButton {border-width: 4px; border-radius: 11px; height: 49px; font-size: 39px; icon-size: 42px;}
#centralwidget[zoom="3.5x"] QAbstractButton:focus {border-width: 7px;}
#centralwidget[zoom="3.5x"] QLabel {font-size: 39px;}

/* 4.0x */
#centralwidget[zoom="4x"] QAbstractButton {border-width: 4px; border-radius: 12px; height: 56px; font-size: 44px; icon-size: 48px;}
#centralwidget[zoom="4x"] QAbstractButton:focus {border-width: 8px;}
#centralwidget[zoom="4x"] QLabel {font-size: 44px;}

/* 4.5x */
#centralwidget[zoom="4.5x"] QAbstractButton {border-width: 5px; border-radius: 14px; height: 63px; font-size: 50px; icon-size: 54px;}
#centralwidget[zoom="4.5x"] QAbstractButton:focus {border-width: 9px;}
#centralwidget[zoom="4.5x"] QLabel {font-size: 50px;}

/* 5.0x */
#centralwidget[zoom="5x"] QAbstractButton {border-width: 5px; border-radius: 15px; height: 70px; font-size: 55px; icon-size: 60px;}
#centralwidget[zoom="5x"] QAbstractButton:focus {border-width: 10px;}
#centralwidget[zoom="5x"] QLabel {font-size: 55px;}
